#!/bin/bash

set -u

if [ -n "${AGENTDOTS_TEST_NPX_LOG:-}" ]; then
    {
        printf 'npx-stub'
        printf ' <%s>' "$@"
        printf '\n'
    } >>"$AGENTDOTS_TEST_NPX_LOG"
fi

# A local-path `skills add` is the per-checkout scan; a URL add is an external
# pack. Failing only the local form lets a test reach the scan through a
# healthy Orca step and assert that the failure names the project to fix.
if [ "${1:-}" = "--yes" ] && [ "${2:-}" = skills ] && [ "${3:-}" = add ]; then
    case "${4:-}" in
        /*)
            exit "${AGENTDOTS_TEST_NPX_LOCAL_EXIT:-${AGENTDOTS_TEST_NPX_EXIT:-0}}"
            ;;
    esac
fi

case "$*" in
    "--yes skills list --global --json")
        cat <<'EOF'
[
  {
    "name": "orca-cli",
    "scope": "global",
    "source": "stablyai/orca",
    "agents": ["Codex", "Claude Code", "Pi"]
  },
  {
    "name": "orchestration",
    "scope": "global",
    "source": "stablyai/orca",
    "agents": ["Codex", "Claude Code", "Pi"]
  },
  {
    "name": "computer-use",
    "scope": "global",
    "source": "stablyai/orca",
    "agents": ["Codex", "Claude Code", "Pi"]
  }
]
EOF
        ;;
esac

# Callers that need to see a failing skills tool set this; everything else gets
# the successful path above regardless of which branch matched.
exit "${AGENTDOTS_TEST_NPX_EXIT:-0}"
