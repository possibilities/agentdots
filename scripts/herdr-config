#!/bin/bash

set -euo pipefail

die() {
    printf 'herdr-config: %s\n' "$*" >&2
    exit 1
}

canonical_entry_path() {
    local entry="$1"
    local entry_dir
    local entry_name

    entry_dir=$(dirname -- "$entry")
    entry_name=$(basename -- "$entry")
    [ -d "$entry_dir" ] || return 1
    entry_dir=$(cd -P -- "$entry_dir" && pwd)
    printf '%s/%s\n' "$entry_dir" "$entry_name"
}

# Resolve through any command link so the checkout remains the source of truth
# and worktree installs bind the checkout that performed the install.
script_path="$0"
while [ -L "$script_path" ]; do
    link_target=$(readlink "$script_path")
    case "$link_target" in
        /*) script_path="$link_target" ;;
        *) script_path="$(dirname -- "$script_path")/$link_target" ;;
    esac
done
script_dir=$(cd -P -- "$(dirname -- "$script_path")" && pwd)
repo_root=$(cd -P -- "$script_dir/.." && pwd)

config_source="${AGENTSTART_HERDR_CONFIG_SOURCE:-$repo_root/config/herdr/config.toml}"
config_target="${AGENTSTART_HERDR_CONFIG_TARGET:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml}"
state_root="${AGENTSTART_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/agentstart}"
lock_dir="${AGENTSTART_HERDR_LOCK_DIR:-$state_root/herdr-config.lock}"
herdr_bin="${AGENTSTART_HERDR_BIN:-herdr}"
managed_marker="# Generated by AgentStart's herdr-config. Do not edit."
# Herdr writes its own keys into the live file (`onboarding`), so the config is
# rendered rather than linked: neither checkout becomes program-written state.
legacy_marker="# Generated by AgentStart's herdr-tinty. Do not edit."

lock_owned=0
temporary_file=''

cleanup() {
    if [ -n "$temporary_file" ] && [ -e "$temporary_file" ]; then
        rm -f -- "$temporary_file"
    fi
    if [ "$lock_owned" -eq 1 ]; then
        rm -f -- "$lock_dir/pid"
        rmdir -- "$lock_dir" 2>/dev/null || true
        lock_owned=0
    fi
}

trap cleanup EXIT
trap 'exit 130' HUP INT TERM

acquire_lock() {
    local attempts=0
    local owner_pid=''

    mkdir -p -- "$(dirname -- "$lock_dir")"
    while ! mkdir -- "$lock_dir" 2>/dev/null; do
        if [ -f "$lock_dir/pid" ]; then
            IFS= read -r owner_pid <"$lock_dir/pid" || owner_pid=''
            case "$owner_pid" in
                ''|*[!0-9]*) ;;
                *)
                    if ! kill -0 "$owner_pid" 2>/dev/null; then
                        rm -f -- "$lock_dir/pid"
                        rmdir -- "$lock_dir" 2>/dev/null || true
                        continue
                    fi
                    ;;
            esac
        fi
        attempts=$((attempts + 1))
        [ "$attempts" -lt 200 ] \
            || die "timed out waiting for the config update lock: $lock_dir"
        sleep 0.05
    done

    printf '%s\n' "$$" >"$lock_dir/pid"
    lock_owned=1
}

target_is_replaceable() {
    local target="$1"

    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
        return 0
    fi

    # A link is always someone else's: the live config is a rendered file.
    [ ! -L "$target" ] || return 1
    [ -f "$target" ] || return 1
    grep -Fqx "$managed_marker" "$target" \
        || grep -Fqx "$legacy_marker" "$target"
}

render_candidate() {
    local target_dir
    local candidate
    local check_output
    local reload_output

    [ -s "$config_source" ] \
        || die "Herdr base config is missing or empty: $config_source"
    target_is_replaceable "$config_target" \
        || die "refusing to replace independent Herdr config: $config_target"

    target_dir=$(dirname -- "$config_target")
    mkdir -p -- "$target_dir"
    candidate=$(mktemp "$target_dir/.config.toml.XXXXXX")
    temporary_file="$candidate"
    {
        printf '%s\n' "$managed_marker"
        printf '# Base: %s\n\n' "$config_source"
        cat -- "$config_source"
        printf '\n'
    } >"$candidate"
    chmod 600 "$candidate"

    check_output=''
    if ! check_output=$(HERDR_CONFIG_PATH="$candidate" "$herdr_bin" config check 2>&1); then
        printf '%s\n' "$check_output" >&2
        die "Herdr rejected the generated config; the active config was not changed"
    fi

    mv -f -- "$candidate" "$config_target"
    temporary_file=''

    reload_output=''
    if ! reload_output=$("$herdr_bin" server reload-config 2>&1); then
        printf 'herdr-config: config updated; live reload was skipped: %s\n' \
            "$reload_output" >&2
    else
        case "$reload_output" in
            *'"status":"partial"'*)
                printf 'herdr-config: config updated; live reload was partial: %s\n' \
                    "$reload_output" >&2
                ;;
        esac
    fi
}

install_config() {
    command -v "$herdr_bin" >/dev/null 2>&1 \
        || die "Herdr is not installed: $herdr_bin"

    acquire_lock
    render_candidate
}

usage() {
    cat <<'EOF'
Usage: herdr-config <command>

Commands:
  install   Render, validate, and activate AgentStart's Herdr config
EOF
}

case "${1:-}" in
    install)
        [ "$#" -eq 1 ] || die "install takes no arguments"
        install_config
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
