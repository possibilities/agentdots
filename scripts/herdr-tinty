#!/bin/bash

set -euo pipefail

die() {
    printf 'herdr-tinty: %s\n' "$*" >&2
    exit 1
}

canonical_entry_path() {
    local entry="$1"
    local entry_dir
    local entry_name

    entry_dir=$(dirname -- "$entry")
    entry_name=$(basename -- "$entry")
    [ -d "$entry_dir" ] || return 1
    entry_dir=$(cd -P -- "$entry_dir" && pwd)
    printf '%s/%s\n' "$entry_dir" "$entry_name"
}

resolved_link_path() {
    local link_path="$1"
    local link_target

    [ -L "$link_path" ] || return 1
    link_target=$(readlink "$link_path")
    case "$link_target" in
        /*) ;;
        *) link_target="$(dirname -- "$link_path")/$link_target" ;;
    esac
    canonical_entry_path "$link_target"
}

# Resolve through the ~/.local/bin link so the checkout remains the source of
# truth and worktree installs bind the checkout that performed the install.
script_path="$0"
while [ -L "$script_path" ]; do
    link_target=$(readlink "$script_path")
    case "$link_target" in
        /*) script_path="$link_target" ;;
        *) script_path="$(dirname -- "$script_path")/$link_target" ;;
    esac
done
script_dir=$(cd -P -- "$(dirname -- "$script_path")" && pwd)
repo_root=$(cd -P -- "$script_dir/.." && pwd)

code_root="${AGENTSTART_CODE_ROOT:-$HOME/code}"
config_source="${AGENTSTART_HERDR_CONFIG_SOURCE:-$repo_root/config/herdr/config.toml}"
config_target="${AGENTSTART_HERDR_CONFIG_TARGET:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml}"
state_root="${AGENTSTART_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/agentstart}"
theme_state="${AGENTSTART_HERDR_THEME_STATE:-$state_root/herdr-theme.toml}"
lock_dir="${AGENTSTART_HERDR_LOCK_DIR:-$state_root/herdr-tinty.lock}"
legacy_config="$code_root/funk/herdr/.config/herdr/config.toml"
template_source="${AGENTSTART_TINTY_TEMPLATE_SOURCE:-$repo_root/config/tinty/tinted-herdr}"
runtime_template="${AGENTSTART_TINTY_TEMPLATE_TARGET:-$HOME/.local/share/agentstart/tinted-herdr}"
tinty_config_source="${AGENTSTART_TINTY_CONFIG_SOURCE:-$repo_root/config/tinty/config.toml}"
tinty_schemes_config="${AGENTSTART_TINTY_SCHEMES_CONFIG:-$repo_root/config/tinty/schemes-only.toml}"
tinty_config_target="${AGENTSTART_TINTY_CONFIG_TARGET:-${XDG_CONFIG_HOME:-$HOME/.config}/tinted-theming/tinty/config.toml}"
helper_target="${AGENTSTART_HERDR_TINTY_BIN_TARGET:-$HOME/.local/bin/herdr-tinty}"
herdr_bin="${AGENTSTART_HERDR_BIN:-herdr}"
tinty_bin="${AGENTSTART_TINTY_BIN:-tinty}"
managed_marker="# Generated by AgentStart's herdr-tinty. Do not edit."

lock_owned=0
temporary_file=''
temporary_dir=''

cleanup() {
    if [ -n "$temporary_file" ] && [ -e "$temporary_file" ]; then
        rm -f -- "$temporary_file"
    fi
    if [ -n "$temporary_dir" ] && [ -d "$temporary_dir" ]; then
        rm -rf -- "$temporary_dir"
    fi
    if [ "$lock_owned" -eq 1 ]; then
        rm -f -- "$lock_dir/pid"
        rmdir -- "$lock_dir" 2>/dev/null || true
        lock_owned=0
    fi
}

trap cleanup EXIT
trap 'exit 130' HUP INT TERM

acquire_lock() {
    local attempts=0
    local owner_pid=''

    if [ "${AGENTSTART_HERDR_TINTY_LOCK_HELD:-0}" = 1 ]; then
        return 0
    fi

    mkdir -p -- "$(dirname -- "$lock_dir")"
    while ! mkdir -- "$lock_dir" 2>/dev/null; do
        if [ -f "$lock_dir/pid" ]; then
            IFS= read -r owner_pid <"$lock_dir/pid" || owner_pid=''
            case "$owner_pid" in
                ''|*[!0-9]*) ;;
                *)
                    if ! kill -0 "$owner_pid" 2>/dev/null; then
                        rm -f -- "$lock_dir/pid"
                        rmdir -- "$lock_dir" 2>/dev/null || true
                        continue
                    fi
                    ;;
            esac
        fi
        attempts=$((attempts + 1))
        [ "$attempts" -lt 200 ] \
            || die "timed out waiting for theme update lock: $lock_dir"
        sleep 0.05
    done

    printf '%s\n' "$$" >"$lock_dir/pid"
    lock_owned=1
}

target_is_replaceable() {
    local target="$1"
    local linked_path=''
    local legacy_path=''

    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
        return 0
    fi

    if [ -L "$target" ]; then
        linked_path=$(resolved_link_path "$target") || return 1
        legacy_path=$(canonical_entry_path "$legacy_config") || return 1
        [ "$linked_path" = "$legacy_path" ]
        return
    fi

    [ -f "$target" ] \
        && grep -Fqx "$managed_marker" "$target"
}

render_candidate() {
    local fragment="$1"
    local target_dir
    local candidate

    [ -s "$config_source" ] \
        || die "Herdr base config is missing or empty: $config_source"
    [ -s "$fragment" ] \
        || die "Tinty theme fragment is missing or empty: $fragment"
    target_is_replaceable "$config_target" \
        || die "refusing to replace independent Herdr config: $config_target"

    target_dir=$(dirname -- "$config_target")
    mkdir -p -- "$target_dir"
    candidate=$(mktemp "$target_dir/.config.toml.XXXXXX")
    temporary_file="$candidate"
    {
        printf '%s\n' "$managed_marker"
        printf '# Base: %s\n' "$config_source"
        printf '# Palette: managed by Tinty; use herdr-tinty or tinty apply.\n\n'
        cat -- "$config_source"
        printf '\n'
        cat -- "$fragment"
        printf '\n'
    } >"$candidate"
    chmod 600 "$candidate"

    check_output=''
    if ! check_output=$(HERDR_CONFIG_PATH="$candidate" "$herdr_bin" config check 2>&1); then
        printf '%s\n' "$check_output" >&2
        die "Herdr rejected the generated config; the active config was not changed"
    fi

    mkdir -p -- "$(dirname -- "$theme_state")"
    state_candidate=$(mktemp "$(dirname -- "$theme_state")/.herdr-theme.toml.XXXXXX")
    cp -- "$fragment" "$state_candidate"
    chmod 600 "$state_candidate"
    mv -f -- "$state_candidate" "$theme_state"

    mv -f -- "$candidate" "$config_target"
    temporary_file=''

    reload_output=''
    if ! reload_output=$("$herdr_bin" server reload-config 2>&1); then
        printf 'herdr-tinty: config updated; live reload was skipped: %s\n' \
            "$reload_output" >&2
    else
        case "$reload_output" in
            *'"status":"partial"'*)
                printf 'herdr-tinty: config updated; live reload was partial: %s\n' \
                    "$reload_output" >&2
                ;;
        esac
    fi
}

apply_theme() {
    local fragment="$1"

    acquire_lock
    render_candidate "$fragment"
}

cycle_theme() {
    local direction="$1"
    local current=''
    local chosen=''
    local index=-1
    local count
    local i
    local list_file
    local theme
    local -a themes=()

    acquire_lock
    list_file=$(mktemp "$state_root/.tinty-list.XXXXXX")
    temporary_file="$list_file"
    "$tinty_bin" list >"$list_file"
    while IFS= read -r theme || [ -n "$theme" ]; do
        [ -n "$theme" ] || continue
        themes[${#themes[@]}]="$theme"
    done <"$list_file"
    rm -f -- "$list_file"
    temporary_file=''

    count=${#themes[@]}
    [ "$count" -gt 0 ] || die "Tinty returned no themes; run tinty sync"
    if current=$("$tinty_bin" current 2>/dev/null); then
        :
    else
        current=''
    fi
    for ((i = 0; i < count; i += 1)); do
        if [ "${themes[$i]}" = "$current" ]; then
            index=$i
            break
        fi
    done

    if [ "$direction" = next ]; then
        if [ "$index" -lt 0 ]; then
            chosen="${themes[0]}"
        else
            chosen="${themes[$(((index + 1) % count))]}"
        fi
    else
        if [ "$index" -lt 0 ]; then
            chosen="${themes[$((count - 1))]}"
        else
            chosen="${themes[$(((index + count - 1) % count))]}"
        fi
    fi

    AGENTSTART_HERDR_TINTY_LOCK_HELD=1 "$tinty_bin" apply "$chosen"
}

link_owned_file() {
    local source="$1"
    local target="$2"
    local label="$3"
    local linked_path=''
    local source_path

    [ -e "$source" ] || die "$label source is missing: $source"
    source_path=$(canonical_entry_path "$source") \
        || die "cannot resolve $label source: $source"
    if [ -e "$target" ] || [ -L "$target" ]; then
        if [ ! -L "$target" ]; then
            die "refusing to replace independent $label: $target"
        fi
        linked_path=$(resolved_link_path "$target") || true
        [ "$linked_path" = "$source_path" ] \
            || die "refusing to replace independent $label link: $target"
    fi
    mkdir -p -- "$(dirname -- "$target")"
    ln -sfn "$source_path" "$target"
}

install_integration() {
    local runtime_parent
    local stage
    local backup=''
    local template_file

    command -v "$tinty_bin" >/dev/null 2>&1 \
        || die "Tinty is not installed: $tinty_bin"
    command -v "$herdr_bin" >/dev/null 2>&1 \
        || die "Herdr is not installed: $herdr_bin"
    [ -s "$tinty_config_source" ] \
        || die "Tinty config is missing or empty: $tinty_config_source"
    [ -s "$tinty_schemes_config" ] \
        || die "Tinty schemes-only config is missing or empty: $tinty_schemes_config"
    [ -s "$template_source/templates/config.yaml" ] \
        || die "Tinty Herdr template config is missing: $template_source/templates/config.yaml"

    link_owned_file "$script_path" "$helper_target" "herdr-tinty command"
    link_owned_file "$tinty_config_source" "$tinty_config_target" "Tinty config"

    runtime_parent=$(dirname -- "$runtime_template")
    mkdir -p -- "$runtime_parent"
    if [ -e "$runtime_template" ]; then
        [ -d "$runtime_template" ] \
            || die "Tinty Herdr runtime path is not a directory: $runtime_template"
        [ -f "$runtime_template/.agentstart-managed" ] \
            || die "refusing to replace independent Tinty template directory: $runtime_template"
    else
        mkdir -p -- "$runtime_template/templates" "$runtime_template/themes"
        : >"$runtime_template/.agentstart-managed"
        for template_file in config.yaml base16.mustache tinted8.mustache; do
            cp -- "$template_source/templates/$template_file" \
                "$runtime_template/templates/$template_file"
        done
    fi

    # Tinty 0.34.0/0.34.1 correctly installs a local-path item as a symlink,
    # but `sync` then follows that symlink and tries to Git-update the local
    # directory. Install the item, then update only the built-in schemes with
    # an item-free config. This can return to `sync` once a released Tinty
    # treats local-path updates as the documented no-op.
    "$tinty_bin" install --quiet
    "$tinty_bin" update --config "$tinty_schemes_config" --quiet

    stage=$(mktemp -d "$runtime_parent/.tinted-herdr.XXXXXX")
    temporary_dir="$stage"
    mkdir -p -- "$stage/templates" "$stage/themes"
    : >"$stage/.agentstart-managed"
    for template_file in config.yaml base16.mustache tinted8.mustache; do
        [ -s "$template_source/templates/$template_file" ] \
            || die "Tinty Herdr template is missing or empty: $template_source/templates/$template_file"
        cp -- "$template_source/templates/$template_file" "$stage/templates/$template_file"
    done
    "$tinty_bin" build "$stage" --quiet
    find "$stage/themes" -type f -name 'base16-*' -print -quit | grep -q . \
        || die "Tinty did not build any Base16 Herdr themes"
    find "$stage/themes" -type f -name 'tinted8-*' -print -quit | grep -q . \
        || die "Tinty did not build any Tinted8 Herdr themes"

    backup="$runtime_parent/.tinted-herdr.previous.$$"
    mv -- "$runtime_template" "$backup"
    if ! mv -- "$stage" "$runtime_template"; then
        mv -- "$backup" "$runtime_template" || true
        die "failed to activate the built Tinty Herdr templates"
    fi
    temporary_dir=''
    rm -rf -- "$backup"

    "$tinty_bin" init
}

usage() {
    cat <<'EOF'
Usage: herdr-tinty <command>

Commands:
  next                 Apply the next theme from `tinty list`
  previous             Apply the previous theme from `tinty list`
  apply-theme <file>   Render a Tinty-generated palette into Herdr's config
  render-config        Re-render Herdr's config from the last palette
  install              Install/update the AgentStart-owned integration
EOF
}

case "${1:-}" in
    next|previous)
        [ "$#" -eq 1 ] || die "$1 takes no arguments"
        cycle_theme "$1"
        ;;
    apply-theme)
        [ "$#" -eq 2 ] || die "apply-theme requires one theme fragment"
        apply_theme "$2"
        ;;
    render-config)
        [ "$#" -eq 1 ] || die "render-config takes no arguments"
        [ -s "$theme_state" ] \
            || die "no applied Tinty theme is recorded; run tinty apply <scheme>"
        apply_theme "$theme_state"
        ;;
    install)
        [ "$#" -eq 1 ] || die "install takes no arguments"
        install_integration
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
