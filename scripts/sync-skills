#!/bin/bash

set -euo pipefail

die() {
    printf 'AgentStart skill sync: %s\n' "$*" >&2
    exit 1
}

find_brew() {
    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    return 1
}

check_only=0
case "${1:-}" in
    "")
        ;;
    --check)
        check_only=1
        ;;
    -h|--help)
        printf 'Usage: sync-skills [--check]\n'
        exit 0
        ;;
    *)
        printf 'Usage: sync-skills [--check]\n' >&2
        exit 64
        ;;
esac
[ "$#" -le 1 ] || {
    printf 'Usage: sync-skills [--check]\n' >&2
    exit 64
}

# The cheap convergence path: refresh the globally managed skills without
# touching any binary. scripts/install.sh ends with this, and the scheduled
# updater calls it directly every six hours, because a stale runbook misleads
# a session as badly as a stale binary does. Two sources:
#
# - The Orca harness skills (orca-cli, orchestration, computer-use) from the
#   app's repository. The Orca application itself is the machine's — a
#   Homebrew cask left to its own updater — but its skills are harness
#   configuration, which
#   is AgentStart's domain, so they are synchronized and verified here.
# - Every agent* checkout under ~/code that exports skills/<name>/SKILL.md.
#   That convention is the whole interface: AgentStart discovers participants
#   instead of listing them, so a project that grows or renames a skill is
#   synchronized on the next convergence without an edit here. This checkout
#   is itself a participant, and so is agentguidance, whose post-sync hook
#   (below) re-renders the templates the scan ships.
#
# AGENTSTART_CODE_ROOT exists so the tests can point the scan at a fixture tree.
code_root="${AGENTSTART_CODE_ROOT:-$HOME/code}"

if [ "$check_only" -eq 1 ]; then
    printf '  npx --yes skills add https://github.com/stablyai/orca --agent codex claude-code pi --skill orca-cli orchestration computer-use --global --yes\n'
else
    [ "$(uname -s)" = Darwin ] || die "macOS is required"
    [ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

    if [ -n "${AGENTSTART_NPX_BIN:-}" ] && [ -x "$AGENTSTART_NPX_BIN" ]; then
        npx_bin="$AGENTSTART_NPX_BIN"
    elif command -v npx >/dev/null 2>&1; then
        npx_bin=$(command -v npx)
    else
        # The scheduled updater runs from a LaunchAgent whose PATH never
        # sourced nvm, so npx is missing there even on a machine that has
        # Node. Homebrew matters only as the place nvm.sh lives.
        brew_bin=$(find_brew) \
            || die "npx is required to synchronize agent skills"
        nvm_script="$("$brew_bin" --prefix)/opt/nvm/nvm.sh"
        if [ -s "$nvm_script" ]; then
            export NVM_DIR="$HOME/.nvm"
            # shellcheck disable=SC1090
            source "$nvm_script" --no-use
            if nvm version default >/dev/null 2>&1; then
                nvm use --silent default
            fi
        fi
        npx_bin=$(command -v npx) \
            || die "npx is required to synchronize agent skills"
    fi

    printf 'Synchronizing the globally managed Orca agent skills.\n'
    "$npx_bin" --yes skills add https://github.com/stablyai/orca \
        --agent codex claude-code pi \
        --skill orca-cli orchestration computer-use \
        --global --yes

    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/agentstart-sync-skills.XXXXXX")
    trap 'rm -rf "$tmpdir"' EXIT
    skills_json="$tmpdir/skills.json"
    "$npx_bin" --yes skills list --global --json >"$skills_json"

    /usr/bin/jq -e '
      def has_agent($name): .agents | index($name) != null;
      [
        .[]
        | select(
            (.name == "orca-cli" or
             .name == "orchestration" or
             .name == "computer-use") and
            .scope == "global" and
            .source == "stablyai/orca" and
            has_agent("Codex") and
            has_agent("Claude Code") and
            has_agent("Pi")
          )
        | .name
      ]
      | unique
      | sort == ["computer-use", "orca-cli", "orchestration"]
    ' "$skills_json" >/dev/null || die "Orca global skill verification failed"

    printf 'Verified the Orca global skills for Codex, Claude Code, and Pi.\n'
fi

if [ ! -d "$code_root" ]; then
    [ "$check_only" -eq 1 ] || printf 'AgentStart skill sync: no checkout root at %s; skipping the project scan.\n' \
        "$code_root"
    exit 0
fi

synchronized=0
for project in "$code_root"/agent*/; do
    project=${project%/}
    [ -d "$project" ] || continue
    project_name=${project##*/}

    # A checkout with no skills/<name>/SKILL.md simply is not a participant.
    # That is the convention working, not a misconfiguration, so it passes
    # without comment.
    skill_names=()
    while IFS= read -r skill_name; do
        [ -n "$skill_name" ] || continue
        skill_names+=("$skill_name")
    done < <(
        for skill_dir in "$project"/skills/*/; do
            [ -f "$skill_dir/SKILL.md" ] || continue
            skill_dir=${skill_dir%/}
            printf '%s\n' "${skill_dir##*/}"
        done | LC_ALL=C sort
    )
    [ "${#skill_names[@]}" -gt 0 ] || continue
    synchronized=$((synchronized + 1))

    if [ "$check_only" -eq 1 ]; then
        printf '  npx --yes skills add "%s" --agent codex claude-code pi --skill %s --global --yes\n' \
            "$project" "${skill_names[*]}"
        if [ -x "$project/scripts/post-sync" ]; then
            printf '  "%s/scripts/post-sync"  # the participant'\''s post-sync hook, after its skills land\n' \
                "$project"
        fi
        continue
    fi

    # One invocation per project rather than one per skill: the skills tool
    # ships each named skill directory whole — SKILL.md, agents/openai.yaml,
    # and any reference files beside them — which is exactly what an agent
    # needs to load the runbook.
    printf 'Synchronizing the %s agent skills (%s).\n' \
        "$project_name" "${skill_names[*]}"
    "$npx_bin" --yes skills add "$project" \
        --agent codex claude-code pi \
        --skill "${skill_names[@]}" \
        --global --yes \
        || die "synchronizing the $project_name agent skills failed: $project"

    # A participant may need to post-process what the scan just shipped:
    # agentguidance re-renders its templates against the operator extension
    # prompts, and without that the sync would strip the extensions until
    # the next render. The hook is the convention — scripts/post-sync,
    # executable, run right after the project's skills land — and it must
    # stay unattended-safe, because this is the six-hour path.
    if [ -x "$project/scripts/post-sync" ]; then
        printf 'Running the %s post-sync hook.\n' "$project_name"
        "$project/scripts/post-sync" \
            || die "the $project_name post-sync hook failed: $project"
    fi
done

if [ "$check_only" -eq 0 ] && [ "$synchronized" -eq 0 ]; then
    printf 'AgentStart skill sync: no agent* checkout under %s exports skills; nothing to synchronize.\n' \
        "$code_root"
fi
