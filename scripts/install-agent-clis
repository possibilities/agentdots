#!/bin/bash

set -euo pipefail

die() {
    printf 'Agentdots agent CLIs installer: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 0 ] || {
    printf 'Usage: install-agent-clis\n' >&2
    exit 64
}

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

# Each project owns its own hardened installer: frozen dependency install, a
# ~/.local/bin symlink back into the checkout, a deployed-SHA receipt, and its
# own refusal rules for dirty trees and foreign files. Agentdots decides only
# that these CLIs belong on this machine. A machine that has not cloned a
# checkout is a skip, not a failure; a present checkout that fails to install
# is a real error and propagates. Rerunning is safe: the installers are
# fix-forward and relinking repoints the same command.
#
# agentusage precedes agentsurface because the launcher shells its balance
# contract and its installer provisions the public claude-swap fork plus the
# codex-swap source shim. The shims installer refuses without `agentsurface`
# on PATH, and Funk's .zshrc already prefixes the shim directory. Installing
# the CLI does not install the shims — that stays a deliberate
# `funk install-agentsurface-shims`.
#
# agentweb, agentscrape, and agentbrain are ordered along the conduit rather
# than by any install-time requirement: agentweb serves the session conduit,
# agentscrape asks it whether an origin has a signed-in session, and
# agentbrain's worker spawns agentscrape for every fetch. Installing them in
# that order keeps a failure legible. agentweb and agentbrain used to be
# Funk's, on the reasoning that a resident service is machine integration; the
# services moved here and the commands followed, so that no checkout is
# installed from two places.
for tool in agentwiki agentboard agentsearch agentkeys agentbus \
    agentweb agentscrape agentbrain agentusage agentsurface; do
    tool_root="$HOME/code/$tool"
    if [ ! -f "$tool_root/scripts/install.sh" ]; then
        printf 'Agentdots agent CLIs installer: no checkout at %s; skipping.\n' "$tool_root"
        continue
    fi
    printf 'Installing %s from %s.\n' "$tool" "$tool_root"
    "$tool_root/scripts/install.sh" --install
done
