<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- agentstart-installer-owned: agentwiki.server.v1 -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>agentwiki.server</string>
	<!-- Both ports are named rather than defaulted. The vault and the artifact
	     bytes answer on separate origins so an artifact's scripts can reach
	     neither the documents nor the network, and a resident service must not
	     silently move either port when a default changes. -->
	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
		<string>serve</string>
		<string>--port</string>
		<string>__PORT__</string>
		<string>--artifact-port</string>
		<string>__ARTIFACT_PORT__</string>
	</array>
	<!-- No vault override: the service reads the default vault, so an operator
	     who moves it with AGENTWIKI_VAULT in a shell does not silently split
	     the browsable copy from the one their agents write to. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Standard: a person is reading the page this renders. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>Umask</key>
	<integer>63</integer>
	<!-- Both ports are bound at startup, so a port still held by a dying
	     predecessor would otherwise spin. -->
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
