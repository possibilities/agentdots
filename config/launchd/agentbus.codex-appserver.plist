<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- agentstart-installer-owned: agentbus.codex-appserver.v1 -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>agentbus.codex-appserver</string>
	<!-- The supervisor keeps every codex app-server this machine needs
	     alive (agentbus ADR 0003): without codex-swap, one default-socket
	     server on the canonical home; with codex-swap present, spawns nothing,
	     because every placed codex run brings its own dedicated account-pinned
	     server via codex-swap. Each run's server is registered on sight and
	     receives exclusively for that session — the bridge polls codex-swap
	     app-server list --json to discover them. -->

	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
		<string>codex-appserver</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Standard, not Background: interactive codex sessions ride this
	     process — starving it starves every attached TUI. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
