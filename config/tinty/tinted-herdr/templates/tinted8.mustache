# Tinty {{scheme.system}} scheme: {{scheme.name}} ({{scheme.slug}})
# Scheme author: {{scheme.author}}
[theme.custom]
accent = "#{{ui.accent.normal.hex}}"
panel_bg = "#{{ui.global.background.normal.hex}}"
sidebar_bg = "#{{ui.chrome.background.normal.hex}}"
active_row_bg = "#{{ui.global.background.light.hex}}"
selection_bg = "#{{ui.selection.background.hex}}"
surface0 = "#{{ui.global.background.dark.hex}}"
surface1 = "#{{ui.global.background.light.hex}}"
# Normal gray stays visible when dim gray collapses into sidebar_bg.
surface_dim = "#{{palette.gray.normal.hex}}"
overlay0 = "#{{palette.gray.normal.hex}}"
overlay1 = "#{{palette.gray.bright.hex}}"
text = "#{{ui.global.foreground.normal.hex}}"
subtext0 = "#{{palette.gray.bright.hex}}"
mauve = "#{{palette.magenta.normal.hex}}"
green = "#{{ui.status.success.hex}}"
yellow = "#{{ui.status.warning.hex}}"
red = "#{{ui.status.error.hex}}"
blue = "#{{ui.status.info.hex}}"
teal = "#{{palette.cyan.normal.hex}}"
peach = "#{{palette.orange.normal.hex}}"
